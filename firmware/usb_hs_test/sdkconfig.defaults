CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Early (pre-v3) ESP32-P4 silicon
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Use the P4's USB 2.0 High-Speed OTG controller (middle USB-C port)
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TINYUSB_VENDOR_COUNT=0
CONFIG_TINYUSB_CDC_COUNT=0
CONFIG_TINYUSB_MSC_ENABLED=n
